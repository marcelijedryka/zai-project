# Copy to .env and fill in. Never commit the real file.

# --- Database (used by the db container and to build DATABASE_URL) ---
POSTGRES_USER=zai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zai

# --- API ---
ENVIRONMENT=dev

# --- Generator (never hard-code; pass via env or prompt) ---
ZAI_API_URL=http://localhost:8000
ZAI_API_KEY=
