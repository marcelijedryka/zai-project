# Copy to .env and fill in (`make dev` does this for you). Never commit the real file.

# --- Database ---
POSTGRES_USER=zai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zai
# Host-side runs (uvicorn/pytest) use the published port on localhost; compose overrides the host to "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Comma-separated explicit allow-list (the SPA dev server by default).
# These origins are also the only ones trusted for cookie-authenticated POST/PUT/DELETE.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Measurement limits (defaults shown; usually left alone)
# EARLIEST_MEASUREMENT_TIMESTAMP=2000-01-01T00:00:00Z   # older measurements are refused (422)
# REJECTION_RETENTION_DAYS=30
# REJECTION_ROWS_PER_SENSOR_PER_MINUTE=60

# Realtime stream (GET /api/measurements/stream)
# SSE_HEARTBEAT_SECONDS=15            # a ': ping' comment keeps idle streams open through proxies
# SSE_MAX_STREAMS_PER_CLIENT=5        # per client address and worker process (429 above)

# --- Generator (never hard-code; pass via env or prompt) ---
ZAI_API_URL=http://localhost:8000
ZAI_API_KEY=
