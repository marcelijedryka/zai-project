# Copy to .env and fill in (`make dev` does this for you). Never commit the real file.

# --- Database ---
POSTGRES_USER=zai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zai
# Host-side runs (uvicorn/pytest) use the published port on localhost; compose overrides the host to "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Comma-separated explicit allow-list (the SPA dev server by default).
# These origins are also the only ones trusted for cookie-authenticated POST/PUT/DELETE.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Generator (never hard-code; pass via env or prompt) ---
ZAI_API_URL=http://localhost:8000
ZAI_API_KEY=
